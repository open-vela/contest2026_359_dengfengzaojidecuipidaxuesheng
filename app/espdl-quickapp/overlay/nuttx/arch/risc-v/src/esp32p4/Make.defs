include common/Make.defs
# P4 uses the Espressif SYSTIMER, not the generic CLINT timer.
CMN_CSRCS := $(filter-out riscv_mtimer.c,$(CMN_CSRCS))
include common/espressif/Make.defs

CHIP_CSRCS += esp_chip_rev.c esp_atomic64.c
ifeq ($(CONFIG_ESPRESSIF_MIPI_DSI),y)
CHIP_CSRCS += esp32p4_camera_cache.c
CHIP_CSRCS += esp32p4_camera_timing.c
endif
ifneq ($(filter y,$(CONFIG_ESP32P4_PPA) $(CONFIG_ESP32P4_JPEG)),)
CHIP_CSRCS += esp32p4_dma2d.c
endif
ifeq ($(CONFIG_ESP32P4_JPEG),y)
P4_JPEG_HAL = chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_hal_jpeg
CHIP_CSRCS += esp32p4_jpeg.c esp32p4_jpeg_parse.c esp32p4_jpeg_emit.c
CHIP_CSRCS += $(P4_JPEG_HAL)/jpeg_hal.c
INCLUDES += -I$(ARCH_SRCDIR)/$(P4_JPEG_HAL)/include
INCLUDES += -I$(ARCH_SRCDIR)/$(P4_JPEG_HAL)/esp32p4/include
endif

ifeq ($(CONFIG_ESP32P4_PPA),y)
CHIP_CSRCS += esp32p4_ppa.c
INCLUDES += -I$(ARCH_SRCDIR)/chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_hal_ppa/include
INCLUDES += -I$(ARCH_SRCDIR)/chip/$(ESP_HAL_3RDPARTY_REPO)/components/esp_hal_ppa/esp32p4/include
endif
ifeq ($(CONFIG_ARCH_RISCV_INTXCPT_EXTENSIONS),y)
CHIP_CSRCS += esp32p4_extctx.c
endif

ifeq ($(CONFIG_ESP32P4_SDMMC),y)
CHIP_CSRCS += esp32p4_sdmmc.c
INCLUDES += $(INCDIR_PREFIX)$(ARCH_SRCDIR)$(DELIM)chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_hal_sd$(DELIM)include
INCLUDES += $(INCDIR_PREFIX)$(ARCH_SRCDIR)$(DELIM)chip$(DELIM)$(ESP_HAL_3RDPARTY_REPO)$(DELIM)components$(DELIM)esp_hal_sd$(DELIM)esp32p4$(DELIM)include
endif

ifeq ($(CONFIG_SMP),y)
CHIP_CSRCS += esp32p4_smp.c
endif

CFLAGS += ${DEFINE_PREFIX}_RETARGETABLE_LOCKING

# TODO: Remove these flags once ulp/lp_core/lp_core.c is updated.
CFLAGS += -Wno-array-bounds -Wno-stringop-overflow

ifeq ($(CONFIG_ESP32P4_CAMERA_USB),y)
CAMUSB = chip/camera_usb
CAMCHERRY = $(CAMUSB)/cherryusb
INCLUDES += -I$(ARCH_SRCDIR)/$(CAMUSB) -I$(ARCH_SRCDIR)/$(CAMCHERRY)/common
INCLUDES += -I$(ARCH_SRCDIR)/$(CAMCHERRY)/core -I$(ARCH_SRCDIR)/$(CAMCHERRY)/class/hub
INCLUDES += -I$(ARCH_SRCDIR)/$(CAMCHERRY)/port/dwc2
CHIP_CSRCS += $(CAMCHERRY)/core/usbh_core.c $(CAMCHERRY)/class/hub/usbh_hub.c
CHIP_CSRCS += $(CAMCHERRY)/port/dwc2/usb_hc_dwc2.c $(CAMCHERRY)/usb_osal_nuttx.c
CHIP_CSRCS += $(CAMUSB)/camera_usb_port.c $(CAMUSB)/camera_uvc.c $(CAMUSB)/camera_uvc_protocol.c
INCLUDES += -I$(ARCH_SRCDIR)/$(CAMCHERRY)/class/msc -I$(ARCH_SRCDIR)/$(CAMCHERRY)/class/hid -I$(ARCH_SRCDIR)/$(CAMCHERRY)/class/cdc
CHIP_CSRCS += $(CAMCHERRY)/class/msc/usbh_msc.c $(CAMCHERRY)/class/hid/usbh_hid.c
CHIP_CSRCS += $(CAMCHERRY)/core/usbd_core.c $(CAMCHERRY)/port/dwc2/usb_dc_dwc2.c $(CAMCHERRY)/class/cdc/usbd_cdc_acm.c
CHIP_CSRCS += $(CAMUSB)/board_usb.c $(CAMUSB)/board_usb_mode.c $(CAMUSB)/board_usb_cdc.c
CHIP_CSRCS += $(CAMUSB)/board_usb_audio.c $(CAMUSB)/board_usb_audio_protocol.c
endif
