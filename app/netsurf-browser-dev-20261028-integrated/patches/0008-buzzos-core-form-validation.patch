+bool js_request_submit(jsthread *thread, struct dom_node *form,
+		struct dom_node *submitter)
+{
+	if (thread == NULL)
+		return false;
+	if (!qjs_may_navigate(thread) || !JS_IsFunction(thread->ctx, thread->native_form_submit))
+		return true;
+	JSContext *ctx = thread->ctx;
+	qjs_deadline_start(thread);
