+		qjs_dom_wrap_node(thread, form),
+		submitter != NULL ? qjs_dom_wrap_node(thread, submitter) : JS_NULL,
+		JS_NewBool(ctx, submitter == NULL)
+	};
+	JSValue result = JS_Call(ctx, thread->native_form_submit, JS_UNDEFINED, 3, arguments);
+	if (JS_IsException(result))
+		qjs_dump_error(ctx);
+	JS_FreeValue(ctx, result);
+	for (int index = 0; index < 3; index++)
+		JS_FreeValue(ctx, arguments[index]);
+	qjs_deadline_stop(thread);
+	qjs_run_jobs(ctx);
+	return true;
