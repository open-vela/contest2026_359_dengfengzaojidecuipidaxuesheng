 /* forward declaration to break cycles */
+/* Flex item intrinsic contributions include a definite preferred width.
+ * Keep the item's own content widths intact for flex shrink/automatic minima. */
+static void layout_flex_width_contribution(const struct box *item,
+        const css_unit_ctx *ctx, int *minimum, int *maximum)
+{
+    int preferred, fixed = 0;
+    float fraction = 0;
+    css_fixed value = 0;
+    css_unit unit = CSS_UNIT_PX;
+    bool content_box;
+    if (item->style == NULL || css_computed_width_px(item->style, ctx,
+            -1, &preferred) != CSS_WIDTH_SET)
+        return;
+    if (css_computed_max_width(item->style, &value, &unit) ==
+            CSS_MAX_WIDTH_SET && unit != CSS_UNIT_PCT) {
+        int limit = FIXTOINT(css_unit_len2device_px(item->style, ctx, value, unit));
+        preferred = min(preferred, max(limit, 0));
+    }
+    if (css_computed_min_width(item->style, &value, &unit) ==
+            CSS_MIN_WIDTH_SET && unit != CSS_UNIT_PCT) {
+        int limit = FIXTOINT(css_unit_len2device_px(item->style, ctx, value, unit));
+        preferred = max(preferred, limit);
+    }
+    content_box = css_computed_box_sizing(item->style) != CSS_BOX_SIZING_BORDER_BOX;
+    calculate_mbp_width(ctx, item->style, LEFT, true, content_box,
+            content_box, &fixed, &fraction);
+    calculate_mbp_width(ctx, item->style, RIGHT, true, content_box,
+            content_box, &fixed, &fraction);
+    fraction = max(0, min(fraction, 0.9));
+    preferred = max(0, (preferred + fixed) / (1.0 - fraction));
+    *minimum = max(*minimum, preferred);
+    *maximum = max(*maximum, preferred);
+}
