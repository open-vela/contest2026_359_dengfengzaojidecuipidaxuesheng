+
+bool urldb_set_cookie_from_script(const char *header, nsurl *url)
+{
+    if (header == NULL || url == NULL || strchr(header, '\r') || strchr(header, '\n'))
+        return false;
+    /* A script assignment sets one cookie. Do not let the HTTP parser's
+     * legacy comma-separated header support turn it into several cookies.
+     * The weekday comma in an Expires attribute remains valid. */
+    const char *part = header;
+    while (*part) {
+        const char *end = strchr(part, ';');
+        if (end == NULL) end = part + strlen(part);
+        const char *name = part;
+        while (name < end && (*name == ' ' || *name == '\t')) name++;
+        const char *comma = memchr(part, ',', end - part);
+        if (comma && (part == header || end - name < 8 || strncasecmp(name, "expires=", 8) ||
+                memchr(name + 8, '=', end - name - 8) || memchr(comma + 1, ',', end - comma - 1)))
+            return false;
+        part = *end ? end + 1 : end;
+    }
+    size_t length = strlen(header);
+    char *terminated = malloc(length + 3);
+    if (terminated == NULL) return false;
+    memcpy(terminated, header, length);
+    memcpy(terminated + length, "\r\n", 3);
+    bool result = urldb_set_cookie_internal(terminated, url, NULL, true);
+    free(terminated);
+    return result;
+}
 
