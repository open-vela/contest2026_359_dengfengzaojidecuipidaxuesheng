+/* Keep the old document alive while transferring its pending nodes. The
+ * subtree, attributes and associated template fragments keep their identity. */
+void _dom_node_adopt_owner(dom_node_internal *node, dom_document *doc)
+{
+	dom_document *old = node->owner;
+	dom_node_internal *child;
+	bool pending;
+	if (old != NULL)
+		dom_node_ref(old);
+	if (old != doc) {
+		pending = node->pending_list.prev != &node->pending_list;
+		if (pending)
+			_dom_node_remove_pending(node);
+		node->owner = doc;
+		if (pending || (old == NULL && node->parent == NULL))
+			_dom_node_mark_pending(node);
+	}
+	if (node->type == DOM_ELEMENT_NODE) {
+		_dom_element_adopt_attributes((dom_element *)node, doc);
+		if (dom_html_element_is_template((dom_node *)node)) {
+			dom_document_fragment *content =
+				((dom_html_element *)node)->template_content;
+			if (content != NULL)
+				_dom_node_adopt_owner((dom_node_internal *)content, doc);
+		}
+	}
+	for (child = node->first_child; child != NULL; child = child->next)
+		_dom_node_adopt_owner(child, doc);
+	if (old != doc) {
+		dom_user_data *ud = node->user_data;
+		while (ud != NULL) {
+			dom_user_data *next = ud->next;
+			if (ud->handler != NULL)
+				ud->handler(DOM_NODE_ADOPTED, ud->key, ud->data,
+						(dom_node *)node, NULL);
+			ud = next;
+		}
+	}
+	if (old != NULL)
+		dom_node_unref(old);
+}
