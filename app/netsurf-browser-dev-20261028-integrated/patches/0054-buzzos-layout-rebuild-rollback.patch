+	struct box *box;
+};
+
+static void html_rebuild_restore_boxes(struct box *box, bool allow_create)
+{
+	for (; box != NULL; box = box->next) {
+		if (!(box->flags & CLONE)) {
+			if (box->node != NULL) {
+				void *old = NULL, *mapped = NULL;
+				dom_node_get_user_data(box->node,
+					corestring_dom___ns_key_box_node_data,
+					&mapped);
+				/* Hidden candidates remove the key itself. Recreating it
+				 * can allocate, so defer that case until temporary layout
+				 * memory has been released. Existing keys need no memory. */
+				if (mapped != NULL || allow_create)
+					dom_node_set_user_data(box->node,
+						corestring_dom___ns_key_box_node_data,
+						box, NULL, &old);
+			}
+			if (box->gadget != NULL)
+				box->gadget->box = box;
+		}
+		if (box->list_marker != NULL)
+			html_rebuild_restore_boxes(box->list_marker, allow_create);
+		if (box->children != NULL)
