+static void html_rebuild_restore_objects(html_content *c,
+		struct rebuild_object_state *saved, size_t count,
+		unsigned int active, unsigned int num_objects)
+{
+	struct content_html_object **link = &c->object_list;
+	size_t i;
+	while (*link != NULL) {
