--- /dev/null
+++ b/libparserutils/src/charset/codecs/codec_gbk.c
@@ -0,0 +1,186 @@
+#include <stdlib.h>
+#include <string.h>
+#include <iconv.h>
+
+#include <parserutils/charset/mibenum.h>
+
+#include "charset/codecs/codec_impl.h"
+
+typedef struct charset_gbk_codec {
+	parserutils_charset_codec base;
+	uint8_t lead;
+	uint8_t write_buf[4];
+	size_t write_len;
+} charset_gbk_codec;
+
+static bool charset_gbk_codec_handles_charset(const char *charset)
+{
+	uint16_t match = parserutils_charset_mibenum_from_name(charset,
+			strlen(charset));
+
+	return match != 0 &&
+			(match == parserutils_charset_mibenum_from_name("GBK", 3) ||
+			 match == parserutils_charset_mibenum_from_name("GB2312", 6) ||
+			 match == parserutils_charset_mibenum_from_name("GB_2312-80", 10));
+}
+
+static parserutils_error charset_gbk_codec_destroy(parserutils_charset_codec *codec)
+{
+	(void)codec;
+	return PARSERUTILS_OK;
+}
+
+static parserutils_error charset_gbk_codec_reset(parserutils_charset_codec *codec)
+{
+	charset_gbk_codec *gbk = (charset_gbk_codec *)codec;
+
+	gbk->lead = 0;
+	gbk->write_len = 0;
+	return PARSERUTILS_OK;
+}
+
+static parserutils_error charset_gbk_codec_encode(parserutils_charset_codec *codec,
+		const uint8_t **source, size_t *sourcelen,
+		uint8_t **dest, size_t *destlen)
+{
+	charset_gbk_codec *gbk = (charset_gbk_codec *)codec;
+	bool flush = *sourcelen == 0;
+
+	while (*sourcelen > 0 || gbk->write_len == 4 ||
+			(flush && gbk->write_len > 0)) {
+		uint32_t codepoint;
+		unsigned int encoded;
+		size_t length;
+		const uint8_t *initial_source = *source;
+		size_t initial_length = *sourcelen;
+		size_t initial_buffered = gbk->write_len;
+
+		while (gbk->write_len < 4 && *sourcelen > 0) {
+			gbk->write_buf[gbk->write_len++] = **source;
+			(*source)++;
+			(*sourcelen)--;
+		}
+		if (gbk->write_len < 4 && !flush)
+			break;
+		codepoint = gbk->write_len == 4 ?
+				((uint32_t)gbk->write_buf[0] << 24) |
+				((uint32_t)gbk->write_buf[1] << 16) |
+				((uint32_t)gbk->write_buf[2] << 8) |
+				gbk->write_buf[3] : 0xffffffffU;
+		if (codepoint < 0x80) {
+			encoded = codepoint;
+			length = 1;
+		} else if (codepoint == 0x20ac) {
+			encoded = 0x80;
+			length = 1;
+		} else {
+			encoded = buzzos_gbk_encode(codepoint);
+			if (encoded == 0) {
+				if (codec->errormode == PARSERUTILS_CHARSET_CODEC_ERROR_STRICT) {
+					*source = initial_source;
+					*sourcelen = initial_length;
+					gbk->write_len = initial_buffered;
+					return PARSERUTILS_INVALID;
+				}
+				encoded = '?';
+			}
+			length = encoded > 0xff ? 2 : 1;
+		}
+		if (*destlen < length)
+			return PARSERUTILS_NOMEM;
+		if (length == 2)
+			*(*dest)++ = (uint8_t)(encoded >> 8);
+		*(*dest)++ = (uint8_t)encoded;
+		*destlen -= length;
+		gbk->write_len = 0;
+	}
+	return PARSERUTILS_OK;
+}
+
+static parserutils_error charset_gbk_codec_decode(parserutils_charset_codec *codec,
+		const uint8_t **source, size_t *sourcelen,
+		uint8_t **dest, size_t *destlen)
+{
+	charset_gbk_codec *gbk = (charset_gbk_codec *)codec;
+	bool flush = *sourcelen == 0;
+
+	while (*sourcelen > 0 || (flush && gbk->lead != 0)) {
+		uint32_t codepoint;
+		bool consume = true;
+
+		if (gbk->lead != 0) {
+			codepoint = 0;
+			if (*sourcelen > 0) {
+				uint8_t trail = **source;
+				if (trail >= 0x40 && trail <= 0xfe && trail != 0x7f)
+					codepoint = buzzos_gbk_decode(gbk->lead, trail);
+				if (codepoint == 0 && trail < 0x80)
+					consume = false;
+			} else {
+				consume = false;
+			}
+			if (codepoint == 0) {
+				if (codec->errormode == PARSERUTILS_CHARSET_CODEC_ERROR_STRICT)
+					return PARSERUTILS_INVALID;
+				codepoint = 0xfffd;
+			}
+		} else {
+			uint8_t input = **source;
+			if (input >= 0x81 && input <= 0xfe) {
+				if (codec->errormode == PARSERUTILS_CHARSET_CODEC_ERROR_STRICT &&
+						*sourcelen >= 2 &&
+						buzzos_gbk_decode(input, (*source)[1]) == 0)
+					return PARSERUTILS_INVALID;
+				gbk->lead = input;
+				(*source)++;
+				(*sourcelen)--;
+				continue;
+			}
+			if (input < 0x80)
+				codepoint = input;
+			else if (input == 0x80)
+				codepoint = 0x20ac;
+			else {
+				if (codec->errormode == PARSERUTILS_CHARSET_CODEC_ERROR_STRICT)
+					return PARSERUTILS_INVALID;
+				codepoint = 0xfffd;
+			}
+		}
+		if (*destlen < 4)
+			return PARSERUTILS_NOMEM;
+		(*dest)[0] = (uint8_t)(codepoint >> 24);
+		(*dest)[1] = (uint8_t)(codepoint >> 16);
+		(*dest)[2] = (uint8_t)(codepoint >> 8);
+		(*dest)[3] = (uint8_t)codepoint;
+		*dest += 4;
+		*destlen -= 4;
+		gbk->lead = 0;
+		if (consume) {
+			(*source)++;
+			(*sourcelen)--;
+		}
+	}
+	return PARSERUTILS_OK;
+}
+
+static parserutils_error charset_gbk_codec_create(const char *charset,
+		parserutils_charset_codec **codec)
+{
+	charset_gbk_codec *gbk;
+
+	(void)charset;
+	gbk = calloc(1, sizeof(*gbk));
+	if (gbk == NULL)
+		return PARSERUTILS_NOMEM;
+	gbk->base.handler.destroy = charset_gbk_codec_destroy;
+	gbk->base.handler.encode = charset_gbk_codec_encode;
+	gbk->base.handler.decode = charset_gbk_codec_decode;
+	gbk->base.handler.reset = charset_gbk_codec_reset;
+	*codec = &gbk->base;
+	return PARSERUTILS_OK;
+}
+
+const parserutils_charset_handler charset_gbk_codec_handler = {
+	charset_gbk_codec_handles_charset,
+	charset_gbk_codec_create
+};

