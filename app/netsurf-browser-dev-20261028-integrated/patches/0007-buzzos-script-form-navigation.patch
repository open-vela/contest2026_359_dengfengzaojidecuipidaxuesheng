+static nserror form_script_collect(struct form *form, dom_node ***output,
+		uint32_t *count)
+{
+	dom_document *document = NULL;
+	dom_node *node = NULL;
+	dom_node **nodes = NULL;
+	uint32_t length = 0, capacity = 0;
+	nserror result = NSERROR_DOM;
+	if (dom_node_get_owner_document(form->node, &document) != DOM_NO_ERR)
+		return NSERROR_DOM;
+	if (dom_node_get_first_child(document, &node) != DOM_NO_ERR)
+		goto failed;
+	while (node != NULL) {
+		dom_node *next = NULL;
+		dom_node_type type;
+		if (dom_node_get_node_type(node, &type) != DOM_NO_ERR)
+			goto failed;
+		if (type == DOM_ELEMENT_NODE) {
+			dom_string *name = NULL;
+			bool matches = false;
+			if (dom_node_get_node_name(node, &name) != DOM_NO_ERR)
+				goto failed;
+			if (dom_string_isequal(name, corestring_dom_INPUT) ||
+			    dom_string_isequal(name, corestring_dom_SELECT) ||
+			    dom_string_isequal(name, corestring_dom_TEXTAREA) ||
+			    dom_string_isequal(name, corestring_dom_BUTTON))
+				result = form_script_control_matches(form, node, &matches);
+			else
+				result = NSERROR_OK;
+			dom_string_unref(name);
+			if (result != NSERROR_OK)
+				goto failed;
+			if (matches) {
+				if (length == capacity) {
+					uint32_t expanded = capacity ? capacity * 2 : 16;
+					dom_node **allocated;
+					if (expanded < capacity ||
+					    (allocated = realloc(nodes, (size_t)expanded * sizeof(*nodes))) == NULL) {
+						result = NSERROR_NOMEM;
+						goto failed;
+					}
+					nodes = allocated;
+					capacity = expanded;
+				}
+				nodes[length++] = dom_node_ref(node);
+			}
+		}
+		result = NSERROR_DOM;
+		if (dom_node_get_first_child(node, &next) != DOM_NO_ERR)
+			goto failed;
+		if (next == NULL) {
+			dom_node *cursor = dom_node_ref(node);
+			while (cursor != NULL && cursor != (dom_node *)document) {
+				dom_node *parent = NULL;
+				if (dom_node_get_next_sibling(cursor, &next) != DOM_NO_ERR ||
+				    (next == NULL && dom_node_get_parent_node(cursor, &parent) != DOM_NO_ERR)) {
+					dom_node_unref(cursor);
+					goto failed;
+				}
+				dom_node_unref(cursor);
+				cursor = parent;
+				if (next != NULL)
+					break;
+			}
+			if (cursor != NULL)
+				dom_node_unref(cursor);
+		}
+		dom_node_unref(node);
+		node = next;
+	}
+	dom_node_unref(document);
+	*output = nodes;
+	*count = length;
+	return NSERROR_OK;
+failed:
+	if (node != NULL)
+		dom_node_unref(node);
+	if (document != NULL)
+		dom_node_unref(document);
+	while (length > 0)
+		dom_node_unref(nodes[--length]);
+	free(nodes);
+	return result;
+}
