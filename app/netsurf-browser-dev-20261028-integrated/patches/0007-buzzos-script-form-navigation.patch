+static nserror form_script_control_matches(struct form *form, dom_node *node,
+		bool *matches)
+{
+	dom_string *attribute = NULL;
+	dom_string *id = NULL;
+	dom_document *document = NULL;
+	dom_node *owner = NULL;
+	dom_exception error;
+	*matches = false;
+	error = dom_string_create((const uint8_t *)"form", 4, &attribute);
+	if (error != DOM_NO_ERR)
+		return NSERROR_DOM;
+	error = dom_element_get_attribute(node, attribute, &id);
+	dom_string_unref(attribute);
+	if (error != DOM_NO_ERR)
+		return NSERROR_DOM;
+	if (id != NULL) {
+		error = dom_node_get_owner_document(node, &document);
+		if (error == DOM_NO_ERR)
+			error = dom_document_get_element_by_id(document, id, &owner);
+		if (document != NULL)
+			dom_node_unref(document);
+		dom_string_unref(id);
+	} else {
+		error = dom_node_get_parent_node(node, &owner);
+		while (error == DOM_NO_ERR && owner != NULL) {
+			dom_html_element_type type;
+			dom_node_type node_type;
+			dom_node *parent = NULL;
+			error = dom_node_get_node_type(owner, &node_type);
+			if (error != DOM_NO_ERR || node_type != DOM_ELEMENT_NODE)
+				break;
+			if (dom_html_element_get_tag_type(owner, &type) == DOM_NO_ERR &&
+			    type == DOM_HTML_ELEMENT_TYPE_FORM)
+				break;
+			error = dom_node_get_parent_node(owner, &parent);
+			dom_node_unref(owner);
+			owner = parent;
+		}
+	}
+	*matches = owner == form->node;
+	if (owner != NULL)
+		dom_node_unref(owner);
+	return error == DOM_NO_ERR ? NSERROR_OK : NSERROR_DOM;
+}
