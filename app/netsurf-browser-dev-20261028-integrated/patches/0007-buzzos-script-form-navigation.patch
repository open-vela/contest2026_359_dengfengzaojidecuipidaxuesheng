+static JSValue nat_form_submit(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct jsthread *thread = nat_thread(ctx);
+	struct form form = {0};
+	struct form_control submitter = {0};
+	const char *strings[4] = {NULL};
+	nserror result;
+	int index;
+	(void)this_val;
+	if (argc < 6 || !qjs_may_navigate(thread))
+		return JS_UNDEFINED;
+	form.node = nat_node(thread, argv[0]);
+	form.script_submission = true;
+	if (form.node == NULL || !nat_is_tag(form.node, DOM_HTML_ELEMENT_TYPE_FORM))
+		return JS_ThrowTypeError(ctx, "Expected a form element");
+	submitter.node = JS_IsNull(argv[1]) ? form.node : nat_node(thread, argv[1]);
+	if (submitter.node == NULL)
+		return JS_ThrowTypeError(ctx, "Expected a submit button");
+	for (index = 0; index < 4; index++) {
+		strings[index] = JS_ToCString(ctx, argv[index + 2]);
+		if (strings[index] == NULL)
+			goto failed;
+	}
+	form.action = (char *)strings[0];
+	form.method = strcmp(strings[1], "post") == 0 ? method_POST_URLENC : method_GET;
+	form.target = (char *)strings[2];
+	form.accept_charsets = strings[3][0] ? (char *)strings[3] : NULL;
+	form.document_charset = thread->htmlc->encoding;
+	result = form_submit(llcache_handle_get_url(thread->htmlc->base.llcache),
+		browser_window_find_target(thread->bw,
+			form.target[0] ? form.target : thread->htmlc->base_target, 0),
+		&form, &submitter);
+	for (index = 0; index < 4; index++)
+		JS_FreeCString(ctx, strings[index]);
+	if (result != NSERROR_OK)
+		return JS_ThrowInternalError(ctx, "Form navigation failed (%d)", result);
+	return JS_UNDEFINED;
+failed:
+	for (index = 0; index < 4; index++) {
+		if (strings[index] != NULL)
+			JS_FreeCString(ctx, strings[index]);
+	}
+	return JS_EXCEPTION;
+}
