+/* A context or size query does not need a backing store. Materialise only
+ * when pixels will be written or consumed as a drawImage source. */
+static bool cv_ensure_pixels(struct html_canvas *cv)
+{
+	if (cv->px != NULL)
+		return true;
+	if (cv->w <= 0 || cv->h <= 0)
+		return false;
+	cv->px = calloc((size_t)cv->w * cv->h, 4);
+	return cv->px != NULL;
+}
 
