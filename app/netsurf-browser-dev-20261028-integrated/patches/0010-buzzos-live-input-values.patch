+/* Attribute-backed modes retain their existing setter semantics. Text and
+ * typed controls need a dirty live value: changing .value must not change the
+ * default value attribute used by reset and numeric step-base calculation. */
+static bool input_live_value_mode(dom_html_input_element *element)
+{
+	dom_string *type = NULL;
+	bool live = true;
+	if (dom_html_input_element_get_type(element, &type) == DOM_NO_ERR && type != NULL) {
+		const char *data = dom_string_data(type);
+		size_t length = dom_string_byte_length(type);
+		const char *attribute_modes[] = {"hidden", "submit", "image", "reset", "button", "checkbox", "radio"};
+		for (size_t i = 0; i < sizeof(attribute_modes) / sizeof(attribute_modes[0]); i++) {
+			if (length == strlen(attribute_modes[i]) && strncasecmp(data, attribute_modes[i], length) == 0) {
+				live = false;
+				break;
+			}
+		}
+		dom_string_unref(type);
+	}
+	return live;
+}
+
+dom_exception dom_html_input_element_get_value(dom_html_input_element *element, dom_string **value)
+{
+	if (input_live_value_mode(element) && element->current_value_set) {
+		*value = element->current_value == NULL ? NULL : dom_string_ref(element->current_value);
+		return DOM_NO_ERR;
+	}
+	return dom_element_get_attribute(element,
+		((dom_html_document *)((dom_node_internal *)element)->owner)->memoised[hds_value], value);
+}
+
+dom_exception dom_html_input_element_set_value(dom_html_input_element *element, dom_string *value)
+{
+	if (!input_live_value_mode(element)) {
+		return dom_element_set_attribute(element,
+			((dom_html_document *)((dom_node_internal *)element)->owner)->memoised[hds_value], value);
+	}
+	/* Take the incoming reference first: callers may pass the current value. */
+	if (value != NULL) dom_string_ref(value);
+	if (element->current_value != NULL) dom_string_unref(element->current_value);
+	element->current_value = value;
+	element->current_value_set = true;
+	return DOM_NO_ERR;
+}
 
