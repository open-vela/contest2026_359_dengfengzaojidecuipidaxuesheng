+static JSValue qjs_throw_dom_exception(JSContext *ctx, dom_exception exc)
+{
+	const char *name;
+	JSValue global, ctor, args[2], error;
+	switch (exc) {
+	case DOM_HIERARCHY_REQUEST_ERR: name = "HierarchyRequestError"; break;
+	case DOM_WRONG_DOCUMENT_ERR: name = "WrongDocumentError"; break;
+	case DOM_NOT_FOUND_ERR: name = "NotFoundError"; break;
+	case DOM_NO_MODIFICATION_ALLOWED_ERR: name = "NoModificationAllowedError"; break;
+	case DOM_NOT_SUPPORTED_ERR: name = "NotSupportedError"; break;
+	case DOM_INVALID_STATE_ERR: name = "InvalidStateError"; break;
+	case DOM_NO_MEM_ERR: return JS_ThrowOutOfMemory(ctx);
+	default: return JS_ThrowInternalError(ctx, "DOM operation failed (%d)", exc);
+	}
+	global = JS_GetGlobalObject(ctx);
+	ctor = JS_GetPropertyStr(ctx, global, "DOMException");
+	args[0] = JS_NewString(ctx, "The DOM operation could not be completed");
+	args[1] = JS_NewString(ctx, name);
+	error = JS_CallConstructor(ctx, ctor, 2, args);
+	JS_FreeValue(ctx, args[0]);
+	JS_FreeValue(ctx, args[1]);
+	JS_FreeValue(ctx, ctor);
+	JS_FreeValue(ctx, global);
+	return JS_IsException(error) ? error : JS_Throw(ctx, error);
+}
