+static JSValue n_canvas_png(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	static const char prefix[] = "data:image/png;base64,";
+	static const char base64[] =
+		"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	struct jsthread *thread = JS_GetContextOpaque(ctx);
+	dom_node *node = argc > 0 ? qjs_dom_node_of(ctx, argv[0]) : NULL;
+	struct html_canvas *canvas;
+	uint8_t *pixels;
+	unsigned char *png = NULL;
+	size_t png_size = 0;
+	JSValue result;
+	unsigned error;
+	int width, height;
+	size_t index, offset;
+
+	if (thread == NULL || node == NULL || thread->htmlc == NULL ||
+	    (canvas = html_canvas_for_node(thread->htmlc, node, true)) == NULL)
+		return JS_ThrowTypeError(ctx, "invalid canvas");
+	html_canvas_get_size(canvas, &width, &height);
+	if (width <= 0 || height <= 0)
+		return JS_NULL;
+	if ((uint64_t)width * height > 4 * 1024 * 1024)
+		return JS_ThrowRangeError(ctx, "canvas is too large to export");
+	pixels = malloc((size_t)width * height * 4);
+	if (pixels == NULL)
+		return JS_ThrowOutOfMemory(ctx);
+	html_canvas_get_image_data(canvas, 0, 0, width, height, pixels);
+	error = lodepng_encode32(&png, &png_size, pixels, width, height);
+	free(pixels);
+	if (error != 0) {
+		free(png);
+		return JS_ThrowInternalError(ctx, "canvas PNG encoding failed: %s",
+				lodepng_error_text(error));
+	}
+	if (argc > 1 && JS_ToBool(ctx, argv[1])) {
+		char *url;
+		size_t prefix_size = sizeof(prefix) - 1;
+		size_t url_size;
+
+		if (png_size > 32 * 1024 * 1024) {
+			free(png);
+			return JS_ThrowRangeError(ctx, "canvas PNG is too large");
+		}
+		url_size = prefix_size + ((png_size + 2) / 3) * 4;
+		url = malloc(url_size);
+		if (url == NULL) {
+			free(png);
+			return JS_ThrowOutOfMemory(ctx);
+		}
+		memcpy(url, prefix, prefix_size);
+		offset = prefix_size;
+		for (index = 0; index < png_size; index += 3) {
+			uint32_t chunk = (uint32_t)png[index] << 16;
+
+			if (index + 1 < png_size)
+				chunk |= (uint32_t)png[index + 1] << 8;
+			if (index + 2 < png_size)
+				chunk |= png[index + 2];
+			url[offset++] = base64[(chunk >> 18) & 63];
+			url[offset++] = base64[(chunk >> 12) & 63];
+			url[offset++] = index + 1 < png_size ?
+				base64[(chunk >> 6) & 63] : '=';
+			url[offset++] = index + 2 < png_size ?
+				base64[chunk & 63] : '=';
+		}
+		result = JS_NewStringLen(ctx, url, url_size);
+		free(url);
+	} else {
+		result = JS_NewArrayBufferCopy(ctx, png, png_size);
+	}
+	free(png);
+	return result;
+}
