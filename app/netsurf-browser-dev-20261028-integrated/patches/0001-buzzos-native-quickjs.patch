+static void qjs_drain_jobs(void *opaque)
+{
+	struct jsheap *heap = opaque;
+	if (heap->draining_jobs || heap->dying || heap->nthreads == 0)
+		return;
+	uint64_t started, now, saved = heap->deadline_ms;
+	nsu_getmonotonic_ms(&started);
+	heap->draining_jobs = true;
+	for (int budget = 128; budget > 0 && JS_IsJobPending(heap->rt); budget--) {
+		JSContext *jctx = NULL;
+		JSContext *pending = JS_GetPendingJobContext(heap->rt);
+		struct jsthread *thread = pending ? JS_GetContextOpaque(pending) : NULL;
+		if (!thread || thread->closed) {
+			if (pending) JS_CancelPendingJobs(pending);
+			else break;
+			continue;
+		}
+		nsu_getmonotonic_ms(&now);
+		if (now - started >= 10) break;
+		heap->deadline_ms = now + 1000;
+		if (saved && saved < heap->deadline_ms) heap->deadline_ms = saved;
+		int result = JS_ExecutePendingJob(heap->rt, &jctx);
+		if (result < 0 && jctx) qjs_dump_error(jctx);
+		if (result == 0) break;
+	}
+	heap->deadline_ms = saved;
+	heap->draining_jobs = false;
+	if (JS_IsJobPending(heap->rt))
+		guit->misc->schedule(1, qjs_drain_jobs, heap);
+}
+
+void qjs_cancel_jobs(struct jsheap *heap)
+{
+	guit->misc->schedule(-1, qjs_drain_jobs, heap);
+}
