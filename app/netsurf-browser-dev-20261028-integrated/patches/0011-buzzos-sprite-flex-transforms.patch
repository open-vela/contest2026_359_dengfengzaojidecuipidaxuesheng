+void box_document_transform(const css_unit_ctx *uctx, struct box *box,
+		float *factor, float *dx, float *dy)
+{
+	*factor = 1; *dx = 0; *dy = 0;
+	for (struct box *b = box; b != NULL; b = b->parent) {
+		float k, tx, ty;
+		int bx, by, ix, iy;
+		if (b->style == NULL || b->type == BOX_TEXT ||
+				b->type == BOX_INLINE_CONTAINER || b->type == BOX_INLINE_END ||
+				b->type == BOX_BR) continue;
+		int w = b->border[LEFT].width + b->padding[LEFT] + b->width +
+				b->padding[RIGHT] + b->border[RIGHT].width;
+		int h = b->border[TOP].width + b->padding[TOP] + b->height +
+				b->padding[BOTTOM] + b->border[BOTTOM].width;
+		if (!cssfx_uniform_transform(b->style, uctx, w, h, &k, &tx, &ty)) {
+			if (!cssfx_translation(b->style, uctx, w, h, &ix, &iy)) continue;
+			k = 1; tx = ix; ty = iy;
+		}
+		box_coords(b, &bx, &by);
+		bx -= b->border[LEFT].width; by -= b->border[TOP].width;
+		*dx = k * *dx + (1 - k) * bx + tx;
+		*dy = k * *dy + (1 - k) * by + ty;
+		*factor *= k;
+	}
+}
