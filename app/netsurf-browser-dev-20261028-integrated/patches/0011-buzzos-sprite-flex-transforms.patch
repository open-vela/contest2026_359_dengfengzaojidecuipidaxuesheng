+bool cssfx_uniform_transform(const css_computed_style *style,
+		const css_unit_ctx *uctx, int w, int h,
+		float *factor, float *dx, float *dy)
+{
+	const char *t = cssfx_raw(style, CSS_PROP_TRANSFORM);
+	const char *origin;
+	float k = 1, tx = 0, ty = 0, ox = w / 2.0f, oy = h / 2.0f;
+	bool any = false;
+
+	if (t == NULL)
+		return false;
+	while (*t != '\0') {
+		float a, b;
+		skip_ws(&t);
+		if (*t == '\0') break;
+		if (match_fn(&t, "scale")) {
+			if (!parse_number(&t, &a)) return false;
+			b = a;
+			skip_ws(&t);
+			if (*t == ',') {
+				t++;
+				if (!parse_number(&t, &b)) return false;
+			}
+			if (!isfinite(a) || a < 0 || a != b) return false;
+			k *= a;
+		} else if (match_fn(&t, "translate")) {
+			if (!cssfx_length(&t, style, uctx, w, &a)) return false;
+			b = 0;
+			skip_ws(&t);
+			if (*t == ',') {
+				t++;
+				if (!cssfx_length(&t, style, uctx, h, &b)) return false;
+			}
+			tx += k * a; ty += k * b;
+		} else if (match_fn(&t, "translateX")) {
+			if (!cssfx_length(&t, style, uctx, w, &a)) return false;
+			tx += k * a;
+		} else if (match_fn(&t, "translateY")) {
+			if (!cssfx_length(&t, style, uctx, h, &a)) return false;
+			ty += k * a;
+		} else if (match_fn(&t, "matrix")) {
+			float m[6];
+			for (int i = 0; i < 6; i++) {
+				if (!parse_number(&t, &m[i]) || !isfinite(m[i])) return false;
+				skip_ws(&t);
+				if (i < 5) { if (*t != ',') return false; t++; }
+			}
+			if (m[1] != 0 || m[2] != 0 || m[0] != m[3] || m[0] < 0) return false;
+			tx += k * m[4]; ty += k * m[5]; k *= m[0];
+		} else {
+			return false;
+		}
+		skip_ws(&t);
+		if (*t != ')') return false;
+		t++;
+		any = true;
+	}
+	if (!any || !isfinite(k) || !isfinite(tx) || !isfinite(ty)) return false;
+	origin = cssfx_raw(style, CSS_PROP_TRANSFORM_ORIGIN);
+	if (origin != NULL) {
+		float x, y;
+		if (parse_pos_component(&origin, style, uctx, w, true, &x)) {
+			ox = x;
+			if (parse_pos_component(&origin, style, uctx, h, false, &y)) oy = y;
+		}
+	}
+	*factor = k;
+	*dx = tx + (1 - k) * ox;
+	*dy = ty + (1 - k) * oy;
+	return isfinite(*dx) && isfinite(*dy);
+}
