+static bool box_raw_non_none(const struct box *box, enum css_properties_e prop)
+{
+	const char *raw = box->style ? cssfx_raw(box->style, prop) : NULL;
+	if (!raw) return false;
+	while (isspace((unsigned char)*raw)) raw++;
+	if (strncasecmp(raw, "none", 4) != 0) return true;
+	raw += 4;
+	while (isspace((unsigned char)*raw)) raw++;
+	return *raw != '\0';
