+static struct box *box_stack_sort(struct box *head)
+{
+	struct box *slow, *fast, *right, *left, *result = NULL, **tail = &result;
+	if (!head || !head->stack_next) return head;
+	slow = head; fast = head->stack_next;
+	while (fast && fast->stack_next) {
+		slow = slow->stack_next; fast = fast->stack_next->stack_next;
+	}
+	right = slow->stack_next; slow->stack_next = NULL;
+	left = box_stack_sort(head); right = box_stack_sort(right);
+	while (left && right) {
+		if (left->stack_z <= right->stack_z) {
+			*tail = left; left = left->stack_next;
+		} else { *tail = right; right = right->stack_next; }
