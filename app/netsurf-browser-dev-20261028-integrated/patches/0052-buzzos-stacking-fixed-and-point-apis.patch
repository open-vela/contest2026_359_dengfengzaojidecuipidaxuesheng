+			/* Text fragments hit their parent element. */
+			if (dom_node_get_parent_node(node, &node) != DOM_NO_ERR || !node) continue;
+			JS_SetPropertyUint32(ctx, array, count++, qjs_dom_wrap_node(t, node));
+			dom_node_unref(node);
+		} else JS_SetPropertyUint32(ctx, array, count++, qjs_dom_wrap_node(t, node));
+	}
+	/* The document element is the viewport fallback. JS reverses and
+	 * de-duplicates this bottom-to-top native list. */
+	return array;
