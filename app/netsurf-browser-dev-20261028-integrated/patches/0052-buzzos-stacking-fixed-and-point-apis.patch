+	positioned = position != CSS_POSITION_STATIC;
+	flex_item = box->parent && (box->parent->type == BOX_FLEX ||
+			box->parent->type == BOX_INLINE_FLEX);
+	z_type = css_computed_z_index(box->style, z);
