+static void box_stack_collect(struct box *box, struct box *owner)
+{
+	struct box *c;
+	box->stack_head = box->stack_tail = box->stack_next = box->paint_next = NULL;
+	box->stack_owner = NULL;
+	box->paint_has_fixed = (box->flags & FIXED_VIEWPORT) != 0;
+	if (box != owner && box_stack_entry(box, &box->stack_context, &box->stack_z)) {
+		box->stack_owner = owner;
