+static JSValue nat_elements_at_point(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct jsthread *t = nat_thread(ctx);
+	JSValue array = JS_NewArray(ctx);
+	double x, y;
+	int sx = 0, sy = 0, width, height, bx = 0, by = 0;
+	uint32_t count = 0;
+	struct box *box, *hit;
+	if (argc < 2 || !t || !t->htmlc || !t->bw) return array;
+	if (JS_ToFloat64(ctx, &x, argv[0]) < 0 || JS_ToFloat64(ctx, &y, argv[1]) < 0) {
+		JS_FreeValue(ctx, array); return JS_EXCEPTION;
+	}
+	if (!isfinite(x) || !isfinite(y)) return array;
+	nat_flush_layout(t);
+	if (!t->htmlc->layout) return array;
+	browser_window_get_dimensions(t->bw, &width, &height);
+	browser_window_script_get_scroll(t->bw, &sx, &sy);
+	if (t->bw->window) {
+		float scale = browser_window_get_scale(t->bw);
+		if (scale > 0) { width /= scale; height /= scale; sx /= scale; sy /= scale; }
+	}
+	if (x < 0 || y < 0 || x >= width || y >= height) return array;
+	box = t->htmlc->layout;
