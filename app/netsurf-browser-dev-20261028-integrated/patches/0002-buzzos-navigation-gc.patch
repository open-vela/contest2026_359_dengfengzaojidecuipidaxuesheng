+static void qjs_release_context(jsthread *thread)
+{
+	JSMemoryUsage before, after;
+	if (thread->ctx == NULL)
+		return;
+	JS_ComputeMemoryUsage(thread->heap->rt, &before);
+	JS_CancelPendingJobs(thread->ctx);
+	qjs_modules_closethread(thread);
+	qjs_dom_teardown(thread);
+	JS_SetContextOpaque(thread->ctx, NULL);
+	JS_FreeContext(thread->ctx);
+	thread->ctx = NULL;
+	JS_RunGC(thread->heap->rt);
+	JS_ComputeMemoryUsage(thread->heap->rt, &after);
+	fprintf(stderr, "[js] closed-context bytes-before=%llu bytes-after=%llu\n",
+		(unsigned long long)before.memory_used_size,
+		(unsigned long long)after.memory_used_size);
+}
+
+static void qjs_release_closed_context(void *opaque)
+{
+	jsthread *thread = opaque;
+	if (!thread->closed || thread->ctx == NULL)
+		return;
+	if (thread->heap->deadline_depth || thread->heap->draining_jobs) {
+		guit->misc->schedule(1, qjs_release_closed_context, thread);
+		return;
+	}
+	qjs_release_context(thread);
+}
+
 nserror js_closethread(jsthread *thread)
 {
-	if (thread == NULL)
+	if (thread == NULL || thread->ctx == NULL)
 		return NSERROR_OK;
 	thread->closed = true;
 	JS_CancelPendingJobs(thread->ctx);
 	qjs_modules_closethread(thread);
 	qjs_dom_closethread(thread);
+	guit->misc->schedule(0, qjs_release_closed_context, thread);
 	return NSERROR_OK;
 }
 
