+void js_mark_input_edit(jsthread *thread, struct dom_node *node)
+{
+	if (thread == NULL || thread->closed || thread->ctx == NULL || node == NULL ||
+	    !JS_IsFunction(thread->ctx, thread->native_input_edit))
+		return;
+	JSContext *ctx = thread->ctx;
+	qjs_deadline_start(thread);
+	JSValue argument = qjs_dom_wrap_node(thread, node);
+	JSValue result = JS_Call(ctx, thread->native_input_edit, JS_UNDEFINED, 1, &argument);
+	if (JS_IsException(result))
+		qjs_dump_error(ctx);
+	JS_FreeValue(ctx, result);
+	JS_FreeValue(ctx, argument);
+	qjs_deadline_stop(thread);
+	/* Do not drain jobs here: the owning widget is still in its callback. */
+}
