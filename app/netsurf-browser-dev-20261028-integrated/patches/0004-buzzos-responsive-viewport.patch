+			html->base.locked || html->reflowing ||
+			html->box_conversion_context != NULL) {
+		if (guit->misc->schedule(40, html_fire_resize_cb, html) == NSERROR_OK)
+			html->resize_event_pending = true;
+		return;
+	}
+	html->resize_event_dirty = false;
+	js_fire_event(html->jsthread, "resize", html->document, NULL);
+}
+
+void html_resize_event_cancel(html_content *html)
+{
+	guit->misc->schedule(-1, html_fire_resize_cb, html);
+	html->resize_event_pending = false;
+	html->resize_event_dirty = false;
+}
