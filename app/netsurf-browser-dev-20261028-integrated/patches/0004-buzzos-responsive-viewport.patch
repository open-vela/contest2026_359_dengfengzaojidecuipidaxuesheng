+			html->rebuild_pending || html->aborted || html->bw == NULL ||
+			html->jsthread == NULL)
+		return;
+	if (guit->misc->schedule(0, html_fire_resize_cb, html) == NSERROR_OK)
+		html->resize_event_pending = true;
+}
