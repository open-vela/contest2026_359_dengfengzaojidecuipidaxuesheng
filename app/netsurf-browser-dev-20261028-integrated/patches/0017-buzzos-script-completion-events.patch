+/* Errors must survive an INFO-filtered build, including exceptions caught
+ * by DOM event dispatch. Logging them as INFO silently hid callback failures. */
+static JSValue qjs_console_error(JSContext *ctx, JSValueConst this_val,
+				 int argc, JSValueConst *argv)
+{
+	for (int i = 0; i < argc; i++) {
+		const char *s = JS_ToCString(ctx, argv[i]);
+		if (s != NULL) {
+			NSLOG(netsurf, ERROR, "js console error: %s", s);
+			JS_FreeCString(ctx, s);
+		}
+	}
+	return JS_UNDEFINED;
+}
