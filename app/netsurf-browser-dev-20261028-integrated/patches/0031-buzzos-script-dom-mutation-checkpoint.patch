+struct html_pending_dom_script {
+	dom_node *node;
+	struct html_pending_dom_script *next;
+};
+
+dom_hubbub_error html_queue_dom_script(html_content *html, dom_node *node)
+{
+	struct html_pending_dom_script *item;
+	for (item = html->pending_dom_scripts; item != NULL; item = item->next)
+		if (item->node == node)
+			return DOM_HUBBUB_OK;
+	item = malloc(sizeof(*item));
+	if (item == NULL)
+		return DOM_HUBBUB_NOMEM;
+	item->node = dom_node_ref(node);
+	item->next = NULL;
+	if (html->pending_dom_scripts_tail != NULL)
+		html->pending_dom_scripts_tail->next = item;
+	else
+		html->pending_dom_scripts = item;
+	html->pending_dom_scripts_tail = item;
+	return DOM_HUBBUB_OK;
+}
+
+/* Called by native DOM bindings after the mutation finishes, before returning
+ * to JavaScript. Pop first so nested insertion can flush synchronously too. */
+void html_flush_dom_scripts(html_content *html)
+{
+	if (html == NULL || dom_document_is_in_mutation_event(html->document))
+		return;
+	while (html->pending_dom_scripts != NULL) {
+		struct html_pending_dom_script *batch = html->pending_dom_scripts;
+		html->pending_dom_scripts = html->pending_dom_scripts_tail = NULL;
+		/* Keep original siblings local: a script inserted by the running
+		 * script must execute before the next original fragment sibling. */
+		while (batch != NULL) {
+			struct html_pending_dom_script *item = batch;
+			bool connected = false;
+			batch = item->next;
+			if (html->enable_scripting && html->document != NULL &&
+					dom_node_contains(html->document, item->node, &connected) == DOM_NO_ERR && connected)
+				html_process_script(html, item->node);
+			dom_node_unref(item->node);
+			free(item);
+		}
+	}
+}
