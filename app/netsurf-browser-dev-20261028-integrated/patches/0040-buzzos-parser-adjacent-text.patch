+/* Character-token insertion merges with preceding Text at the insertion
+ * point. Generic DOM append/insert must continue to preserve node identity. */
+static dom_exception merge_parser_text(dom_node *previous, dom_node *child,
+		bool *merged, void **result)
+{
+	dom_node_type a, b;
+	dom_string *data = NULL;
+	dom_exception err;
+	*merged = false;
+	if (previous == NULL || previous == child) return DOM_NO_ERR;
+	err = dom_node_get_node_type(previous, &a);
+	if (err != DOM_NO_ERR) return err;
+	err = dom_node_get_node_type(child, &b);
+	if (err != DOM_NO_ERR) return err;
+	if (a != DOM_TEXT_NODE || b != DOM_TEXT_NODE) return DOM_NO_ERR;
+	err = dom_characterdata_get_data(child, &data);
+	if (err == DOM_NO_ERR) err = dom_characterdata_append_data(previous, data);
+	dom_string_unref(data);
+	if (err == DOM_NO_ERR) {
+		*result = dom_node_ref(previous);
+		*merged = true;
+	}
+	return err;
+}
