+/* The fragment has no preceding start tag. RCDATA still decodes character
+ * references; raw/script data may use PLAINTEXT here (HTML fragment algorithm)
+ * since no appropriate end tag can be produced. Script execution stays inert
+ * through the existing fragment flag, independently of scripting tokenisation. */
+dom_hubbub_error dom_hubbub_fragment_parser_set_text_context(
+		dom_hubbub_parser *parser, dom_node *context)
+{
+	dom_string *name = NULL, *ns = NULL;
+	dom_exception exc;
+	hubbub_parser_optparams opt;
+	hubbub_error error;
+	const char *raw[] = {"style", "script", "xmp", "iframe", "noembed",
+		"noframes", "noscript", "plaintext"};
+	const char *data;
+	size_t length, i;
+	bool text = false;
+	if (parser == NULL || context == NULL || !parser->fragment)
+		return DOM_HUBBUB_BADPARM;
+	exc = dom_node_get_namespace(context, &ns);
+	if (exc != DOM_NO_ERR) return DOM_HUBBUB_DOM;
+	if (ns != NULL) {
+		bool html = dom_string_byte_length(ns) == 28 &&
+			memcmp(dom_string_data(ns), "http://www.w3.org/1999/xhtml", 28) == 0;
+		dom_string_unref(ns);
+		if (!html) return DOM_HUBBUB_OK;
+	}
+	exc = dom_node_get_local_name(context, &name);
+	if (exc != DOM_NO_ERR) return DOM_HUBBUB_DOM;
+	if (name == NULL) {
+		exc = dom_node_get_node_name(context, &name);
+		if (exc != DOM_NO_ERR) return DOM_HUBBUB_DOM;
+	}
+	if (name == NULL) return DOM_HUBBUB_OK;
+	data = dom_string_data(name); length = dom_string_byte_length(name);
+	opt.content_model.model = HUBBUB_CONTENT_MODEL_PLAINTEXT;
+	if ((length == 5 && strncasecmp(data, "title", length) == 0) ||
+			(length == 8 && strncasecmp(data, "textarea", length) == 0)) {
+		opt.content_model.model = HUBBUB_CONTENT_MODEL_RCDATA;
+		text = true;
+	} else {
+		for (i = 0; i < sizeof(raw) / sizeof(raw[0]); i++) {
+			if (length == strlen(raw[i]) && strncasecmp(data, raw[i], length) == 0) {
+				text = true; break;
+			}
+		}
+	}
+	dom_string_unref(name);
+	if (!text) return DOM_HUBBUB_OK;
+	error = hubbub_parser_setopt(parser->parser,
+		HUBBUB_PARSER_FRAGMENT_TEXT_MODEL, &opt);
+	return error == HUBBUB_OK ? DOM_HUBBUB_OK : DOM_HUBBUB_HUBBUB_ERR | error;
+}
