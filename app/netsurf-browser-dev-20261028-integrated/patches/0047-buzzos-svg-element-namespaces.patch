+/* Namespace metadata must come from the DOM, including foreign elements. */
+static JSValue el_get_namespace_part(JSContext *ctx, JSValueConst this_val, int magic)
+{
+	dom_node *node = qjs_this_node(ctx, this_val);
+	dom_string *value = NULL, *ns = NULL, *lower = NULL;
+	dom_exception exc;
+	JSValue ret;
+	if (node == NULL) return JS_UNDEFINED;
+	if (magic == 0) exc = dom_node_get_namespace(node, &value);
+	else if (magic == 1) exc = dom_node_get_prefix(node, &value);
+	else exc = dom_node_get_local_name(node, &value);
+	if (exc != DOM_NO_ERR) return qjs_throw_dom_exception(ctx, exc);
+	if (magic == 2 && value != NULL) {
+		dom_node_get_namespace(node, &ns);
+		/* libdom's HTML factory stores uppercase internal tag names. */
+		if (ns != NULL && strcmp(dom_string_data(ns), "http://www.w3.org/1999/xhtml") == 0 &&
+		    dom_string_tolower(value, true, &lower) == DOM_NO_ERR) {
+			dom_string_unref(value); value = lower;
+		}
+		if (ns != NULL) dom_string_unref(ns);
+	}
+	ret = value == NULL ? JS_NULL : qjs_ds_to_js(ctx, value);
+	if (value != NULL) dom_string_unref(value);
+	return ret;
+}
