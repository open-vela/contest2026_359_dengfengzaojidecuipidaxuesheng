+static JSValue doc_createElementNS(JSContext *ctx, JSValueConst this_val,
+		int argc, JSValueConst *argv)
+{
+	struct jsthread *t = qjs_thread(ctx);
+	dom_node *node = qjs_this_node(ctx, this_val);
+	dom_string *ns = NULL, *name;
+	dom_element *res = NULL;
+	dom_exception exc;
+	if (argc < 2) return JS_ThrowTypeError(ctx, "createElementNS requires two arguments");
+	if (t == NULL || node == NULL) return JS_NULL;
+	if (!JS_IsNull(argv[0]) && !JS_IsUndefined(argv[0])) {
+		ns = qjs_js_to_ds(ctx, argv[0]);
+		if (ns == NULL) return JS_EXCEPTION;
+		if (dom_string_byte_length(ns) == 0) { dom_string_unref(ns); ns = NULL; }
+	}
+	name = qjs_js_to_ds(ctx, argv[1]);
+	if (name == NULL) { if (ns != NULL) dom_string_unref(ns); return JS_EXCEPTION; }
+	exc = dom_document_create_element_ns((dom_document *)node, ns, name, &res);
+	dom_string_unref(name);
+	if (ns != NULL) dom_string_unref(ns);
+	if (exc != DOM_NO_ERR) return qjs_throw_dom_exception(ctx, exc);
 	return qjs_wrap_and_unref(t, (dom_node *)res);
 }
 
