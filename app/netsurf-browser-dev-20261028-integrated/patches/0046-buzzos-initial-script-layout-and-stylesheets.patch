+	if (c->style_waiting_script != NULL && !c->style_script_resume_pending &&
+	    !c->aborted && !html_script_styles_pending(c) &&
+	    guit->misc->schedule(0, html_style_script_resume_cb, c) == NSERROR_OK)
+		c->style_script_resume_pending = true;
+}
 
 
