+static bool html_script_styles_pending(html_content *c)
+{
+	for (unsigned int i = 0; i < c->stylesheet_count; i++) {
+		struct html_stylesheet *s = &c->stylesheets[i];
+		if (s->unused) continue;
+		if (s->modified) return true;
+		if (s->sheet != NULL &&
+		    content_get_status(s->sheet) != CONTENT_STATUS_DONE &&
+		    content_get_status(s->sheet) != CONTENT_STATUS_ERROR)
+			return true;
+	}
+	return false;
+}
