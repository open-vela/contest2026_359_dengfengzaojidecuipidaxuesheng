+static void html_style_script_resume_cb(void *pw)
+{
+	html_content *c = pw;
+	dom_node *node = c->style_waiting_script;
+	dom_hubbub_error err;
+	c->style_script_resume_pending = false;
+	if (node == NULL || html_script_styles_pending(c)) return;
+	c->style_waiting_script = NULL;
+	c->base.active--;
+	if (c->aborted || c->parser == NULL) {
+		dom_node_unref(node);
+		return;
+	}
+	err = html_process_script(c, node);
+	dom_node_unref(node);
+	/* A synchronous external script now owns the parser pause. */
+	if (err == DOM_HUBBUB_OK && c->parser != NULL && !c->aborted)
+		dom_hubbub_parser_pause(c->parser, false);
+	if (html_can_begin_conversion(c))
+		html_begin_conversion(c);
+}
