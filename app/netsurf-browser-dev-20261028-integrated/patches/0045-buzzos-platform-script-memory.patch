+/* Internal diagnostics, not a web platform memory API. */
+static JSValue nat_memory(JSContext *ctx, JSValueConst this_val,
+                         int argc, JSValueConst *argv)
+{
+    JSMemoryUsage usage;
+    JS_ComputeMemoryUsage(JS_GetRuntime(ctx), &usage);
+    JSValue result = JS_NewObject(ctx);
+    JS_SetPropertyStr(ctx, result, "allocated", JS_NewInt64(ctx, usage.malloc_size));
+    JS_SetPropertyStr(ctx, result, "used", JS_NewInt64(ctx, usage.memory_used_size));
+    JS_SetPropertyStr(ctx, result, "limit", JS_NewInt64(ctx, usage.malloc_limit));
+    return result;
+}
+
