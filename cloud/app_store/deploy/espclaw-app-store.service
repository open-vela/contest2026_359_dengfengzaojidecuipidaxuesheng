[Unit]
Description=ESPClaw App Store
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=espclaw-store
Group=espclaw-store
WorkingDirectory=/opt/espclaw-app-store/current
EnvironmentFile=/etc/espclaw-app-store/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/espclaw-app-store/venv/bin/python -m uvicorn cloud.app_store.app:app --host 127.0.0.1 --port 18765 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/espclaw-app-store

[Install]
WantedBy=multi-user.target
