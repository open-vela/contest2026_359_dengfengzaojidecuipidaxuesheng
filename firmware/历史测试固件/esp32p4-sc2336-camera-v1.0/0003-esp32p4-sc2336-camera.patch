+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static int sc2336_write(FAR struct sc2336_dev_s *priv,
+                        uint16_t reg, uint8_t value)
+{
+  struct i2c_msg_s msg;
+  uint8_t data[3] =
+  {
+    reg >> 8, reg & 0xff, value
+  };
+
+  msg.frequency = SC2336_I2C_FREQ;
+  msg.addr = SC2336_I2C_ADDR;
+  msg.flags = 0;
+  msg.buffer = data;
+  msg.length = sizeof(data);
+  return I2C_TRANSFER(priv->i2c, &msg, 1);
+}
+
+static int sc2336_read(FAR struct sc2336_dev_s *priv,
+                       uint16_t reg, FAR uint8_t *value)
+{
+  struct i2c_msg_s msg[2];
+  uint8_t addr[2] =
+  {
+    reg >> 8, reg & 0xff
+  };
+
+  msg[0].frequency = SC2336_I2C_FREQ;
+  msg[0].addr = SC2336_I2C_ADDR;
+  msg[0].flags = 0;
+  msg[0].buffer = addr;
+  msg[0].length = sizeof(addr);
+  msg[1].frequency = SC2336_I2C_FREQ;
+  msg[1].addr = SC2336_I2C_ADDR;
+  msg[1].flags = I2C_M_READ;
+  msg[1].buffer = value;
+  msg[1].length = 1;
+  return I2C_TRANSFER(priv->i2c, msg, 2);
+}
+
+static bool sc2336_is_available(FAR struct imgsensor_s *sensor)
+{
+  FAR struct sc2336_dev_s *priv = (FAR struct sc2336_dev_s *)sensor;
+  uint8_t high;
+  uint8_t low;
+
+  return sc2336_read(priv, SC2336_REG_CHIP_ID_H, &high) >= 0 &&
+         sc2336_read(priv, SC2336_REG_CHIP_ID_L, &low) >= 0 &&
+         (((uint16_t)high << 8) | low) == SC2336_CHIP_ID;
+}
+
+static int sc2336_init(FAR struct imgsensor_s *sensor)
+{
+  FAR struct sc2336_dev_s *priv = (FAR struct sc2336_dev_s *)sensor;
+  int i;
+  int ret;
+
+  for (i = 0; g_sc2336_regs[i].addr != SC2336_REG_END; i++)
+    {
+      if (g_sc2336_regs[i].addr == SC2336_REG_DELAY)
+        {
+          up_mdelay(g_sc2336_regs[i].val);
+          continue;
+        }
+
+      ret = sc2336_write(priv, g_sc2336_regs[i].addr,
+                         g_sc2336_regs[i].val);
+      if (ret < 0)
+        {
+          snerr("SC2336: register 0x%04x failed: %d\n",
+                g_sc2336_regs[i].addr, ret);
+          return ret;
+        }
+    }
+
+  priv->streaming = false;
+  return OK;
+}
+
+static int sc2336_uninit(FAR struct imgsensor_s *sensor)
+{
+  FAR struct sc2336_dev_s *priv = (FAR struct sc2336_dev_s *)sensor;
+
+  priv->streaming = false;
+  return sc2336_write(priv, SC2336_REG_STREAM, 0x00);
+}
+
+static const char *sc2336_get_driver_name(FAR struct imgsensor_s *sensor)
+{
+  return "SC2336";
+}
+
+static int sc2336_validate(FAR struct imgsensor_s *sensor,
+                           imgsensor_stream_type_t type,
+                           uint8_t nr_datafmts,
+                           FAR imgsensor_format_t *datafmts,
+                           FAR imgsensor_interval_t *interval)
+{
+  if (nr_datafmts != 1 || datafmts == NULL ||
+      datafmts[0].width != SC2336_WIDTH ||
+      datafmts[0].height != SC2336_HEIGHT ||
+      datafmts[0].pixelformat != IMGSENSOR_PIX_FMT_SBGGR8)
+    {
+      return -EINVAL;
+    }
+
+  return OK;
+}
+
+static int sc2336_start(FAR struct imgsensor_s *sensor,
+                        imgsensor_stream_type_t type,
+                        uint8_t nr_datafmts,
+                        FAR imgsensor_format_t *datafmts,
+                        FAR imgsensor_interval_t *interval)
+{
+  FAR struct sc2336_dev_s *priv = (FAR struct sc2336_dev_s *)sensor;
+  uint8_t stream = 0;
+  int ret;
+
+  if (priv->streaming)
+    {
+      return -EBUSY;
+    }
+
+  ret = sc2336_write(priv, SC2336_REG_STREAM, 0x01);
+  if (ret >= 0)
+    {
+      up_mdelay(10);
+      ret = sc2336_read(priv, SC2336_REG_STREAM, &stream);
+      if (ret < 0)
+        {
+          snerr("SC2336: stream-state read failed: %d\n", ret);
+          return ret;
+        }
+
+      syslog(LOG_INFO, "SC2336: stream register=0x%02x\n", stream);
+      if ((stream & 1) == 0)
+        {
+          return -EIO;
+        }
+
+      priv->streaming = true;
+    }
+
+  return ret;
+}
+
+static int sc2336_stop(FAR struct imgsensor_s *sensor,
+                       imgsensor_stream_type_t type)
+{
+  FAR struct sc2336_dev_s *priv = (FAR struct sc2336_dev_s *)sensor;
+  int ret = sc2336_write(priv, SC2336_REG_STREAM, 0x00);
+
+  priv->streaming = false;
+  return ret;
+}
+
+static int sc2336_unsupported(FAR struct imgsensor_s *sensor,
+                              uint32_t id,
+                              FAR imgsensor_supported_value_t *value)
+{
+  return -ENOTTY;
+}
+
+static int sc2336_get(FAR struct imgsensor_s *sensor, uint32_t id,
+                      uint32_t size, FAR imgsensor_value_t *value)
+{
+  return -ENOTTY;
+}
+
+static int sc2336_set(FAR struct imgsensor_s *sensor, uint32_t id,
+                      uint32_t size, imgsensor_value_t value)
+{
+  return -ENOTTY;
+}
+
+static const struct imgsensor_ops_s g_sc2336_ops =
+{
+  .is_available = sc2336_is_available,
+  .init = sc2336_init,
+  .uninit = sc2336_uninit,
+  .get_driver_name = sc2336_get_driver_name,
+  .validate_frame_setting = sc2336_validate,
+  .start_capture = sc2336_start,
+  .stop_capture = sc2336_stop,
+  .get_supported_value = sc2336_unsupported,
+  .get_value = sc2336_get,
+  .set_value = sc2336_set,
+};
+
+static const struct v4l2_fmtdesc g_sc2336_fmtdesc =
+{
+  .pixelformat = V4L2_PIX_FMT_SBGGR8,
+  .description = "8-bit Bayer BGGR",
+};
+
+static const struct v4l2_frmivalenum g_sc2336_frmival =
+{
+  .type = V4L2_FRMIVAL_TYPE_DISCRETE,
+  .discrete.numerator = 1,
+  .discrete.denominator = 30,
+};
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+FAR struct imgsensor_s *sc2336_initialize(
+  FAR struct i2c_master_s *i2c, uint16_t width, uint16_t height)
+{
+  FAR struct sc2336_dev_s *priv;
+
+  if (i2c == NULL || (width != 0 && width != SC2336_WIDTH) ||
+      (height != 0 && height != SC2336_HEIGHT))
+    {
+      return NULL;
+    }
+
+  priv = kmm_zalloc(sizeof(*priv));
+  if (priv == NULL)
+    {
+      return NULL;
+    }
+
+  priv->i2c = i2c;
+  priv->frmsize.type = V4L2_FRMSIZE_TYPE_DISCRETE;
+  priv->frmsize.discrete.width = SC2336_WIDTH;
+  priv->frmsize.discrete.height = SC2336_HEIGHT;
+  priv->sensor.ops = &g_sc2336_ops;
+  priv->sensor.fmtdescs = &g_sc2336_fmtdesc;
+  priv->sensor.fmtdescs_num = 1;
+  priv->sensor.frmsizes = &priv->frmsize;
+  priv->sensor.frmsizes_num = 1;
+  priv->sensor.frmintervals = &g_sc2336_frmival;
+  priv->sensor.frmintervals_num = 1;
+  return &priv->sensor;
+}
