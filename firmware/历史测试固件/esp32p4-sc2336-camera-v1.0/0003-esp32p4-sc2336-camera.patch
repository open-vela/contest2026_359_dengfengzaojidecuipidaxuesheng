index 0000000000000000000000000000000000000000..564769b1e7ecc9fa18fc169b441a6272ab7bd9c9
--- /dev/null
+++ b/boards/risc-v/esp32p4/esp32p4-function-ev-board/src/esp32p4_camera.c
@@ -0,0 +1,283 @@
+/****************************************************************************
+ * boards/risc-v/esp32p4/esp32p4-function-ev-board/src/esp32p4_camera.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <stdint.h>
+#include <syslog.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/i2c/i2c_master.h>
+#include <nuttx/kmalloc.h>
+#include <nuttx/video/imgdata.h>
+#include <nuttx/video/imgsensor.h>
+#include <nuttx/video/sc2336.h>
+#include <nuttx/video/v4l2_cap.h>
+
+#include "espressif/esp_i2c.h"
+#include "espressif/esp_ldo.h"
+#include "espressif/esp_mipi_csi.h"
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#define CAMERA_I2C_PORT      0
+#define CAMERA_DPHY_LDO_CHAN 3
+#define CAMERA_DPHY_LDO_MV   2500
+#define CAMERA_WIDTH         1024
+#define CAMERA_HEIGHT        600
+#define CAMERA_FRAME_SIZE (CAMERA_WIDTH * CAMERA_HEIGHT)
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static struct esp_ldo_config_t g_camera_ldo =
+{
+  .chan_id = CAMERA_DPHY_LDO_CHAN,
+  .voltage_mv = CAMERA_DPHY_LDO_MV,
+};
+
+#ifdef CONFIG_ESPRESSIF_MIPI_CSI_BOOT_TEST
+static volatile uint32_t g_camera_frame_size;
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static int camera_frame_callback(uint8_t result, uint32_t size,
+                                 FAR const struct timeval *ts,
+                                 FAR void *arg)
+{
+  g_camera_frame_size = result == 0 ? size : 0;
+  return OK;
+}
+
+static int camera_boot_test(FAR struct imgsensor_s *sensor,
+                            FAR struct imgdata_s *data)
+{
+  imgdata_format_t datafmt;
+  imgsensor_format_t sensorfmt;
+  imgdata_interval_t datainterval;
+  imgsensor_interval_t sensorinterval;
+  FAR uint8_t *buffer;
+  uint32_t checksum = 2166136261u;
+  uint32_t frame_size;
+  uint8_t minimum = UINT8_MAX;
+  uint8_t maximum = 0;
+  int ret;
+  int i;
+
+  datafmt.width = CAMERA_WIDTH;
+  datafmt.height = CAMERA_HEIGHT;
+  datafmt.pixelformat = IMGDATA_PIX_FMT_SBGGR8;
+  sensorfmt.width = CAMERA_WIDTH;
+  sensorfmt.height = CAMERA_HEIGHT;
+  sensorfmt.pixelformat = IMGSENSOR_PIX_FMT_SBGGR8;
+  datainterval.numerator = 1;
+  datainterval.denominator = 30;
+  sensorinterval.numerator = 1;
+  sensorinterval.denominator = 30;
+
+  buffer = data->ops->alloc(data, 64, CAMERA_FRAME_SIZE);
+  if (buffer == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  ret = IMGSENSOR_INIT(sensor);
+  if (ret < 0)
+    {
+      goto free_buffer;
+    }
+
+  ret = IMGDATA_INIT(data);
+  if (ret < 0)
+    {
+      goto uninit_sensor;
+    }
+
+  ret = IMGDATA_VALIDATE_FRAME_SETTING(data, 1, &datafmt,
+                                       &datainterval);
+  if (ret < 0)
+    {
+      goto uninit_data;
+    }
+
+  ret = IMGSENSOR_VALIDATE_FRAME_SETTING(
+          sensor, IMGSENSOR_STREAM_TYPE_VIDEO, 1, &sensorfmt,
+          &sensorinterval);
+  if (ret < 0)
+    {
+      goto uninit_data;
+    }
+
+  ret = IMGDATA_SET_BUF(data, 1, &datafmt, buffer, CAMERA_FRAME_SIZE);
+  if (ret < 0)
+    {
+      goto uninit_data;
+    }
+
+  g_camera_frame_size = 0;
+  ret = IMGDATA_START_CAPTURE(data, 1, &datafmt, &datainterval,
+                              camera_frame_callback, NULL);
+  if (ret < 0)
+    {
+      goto uninit_data;
+    }
+
+  ret = IMGSENSOR_START_CAPTURE(sensor, IMGSENSOR_STREAM_TYPE_VIDEO,
+                                1, &sensorfmt, &sensorinterval);
+  if (ret < 0)
+    {
+      IMGDATA_STOP_CAPTURE(data);
+      goto uninit_data;
+    }
+
+  for (i = 0; i < 200 && g_camera_frame_size == 0; i++)
+    {
+      up_mdelay(10);
+    }
+
+  if (g_camera_frame_size == 0)
+    {
+      esp_mipi_csi_dump_status();
+    }
+
+  IMGDATA_STOP_CAPTURE(data);
+  IMGSENSOR_STOP_CAPTURE(sensor, IMGSENSOR_STREAM_TYPE_VIDEO);
+  frame_size = g_camera_frame_size;
+  if (frame_size != CAMERA_FRAME_SIZE)
+    {
+      syslog(LOG_ERR, "Camera: first frame timeout or short frame: %lu\n",
+             (unsigned long)frame_size);
+      ret = -ETIMEDOUT;
+      goto uninit_data;
+    }
+
+  for (i = 0; i < frame_size; i++)
+    {
+      uint8_t value = buffer[i];
+
+      minimum = value < minimum ? value : minimum;
+      maximum = value > maximum ? value : maximum;
+      checksum = (checksum ^ value) * 16777619u;
+    }
+
+  if (minimum == maximum)
+    {
+      syslog(LOG_ERR, "Camera: first frame is constant (0x%02x)\n",
+             minimum);
+      ret = -EIO;
+    }
+  else
+    {
+      syslog(LOG_INFO,
+             "Camera: first frame OK, %lu bytes, range=%u..%u, "
+             "fnv1a=0x%08lx\n",
+             (unsigned long)frame_size, minimum, maximum,
+             (unsigned long)checksum);
+      ret = OK;
+    }
+
+uninit_data:
+  IMGDATA_UNINIT(data);
+uninit_sensor:
+  IMGSENSOR_UNINIT(sensor);
+free_buffer:
+  data->ops->free(data, buffer);
+  return ret;
+}
+#endif
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+int board_camera_initialize(void)
+{
+  FAR struct i2c_master_s *i2c;
+  FAR struct imgsensor_s *sensor;
+  FAR struct imgdata_s *data;
+  int ret;
+
+  if (g_camera_ldo.handler == NULL)
+    {
+      ret = esp_ldo_channel_acquire(&g_camera_ldo);
+      if (ret < 0)
+        {
+          syslog(LOG_ERR, "Camera: MIPI D-PHY LDO failed: %d\n", ret);
+          return ret;
+        }
+    }
+
+  i2c = esp_i2cbus_initialize(CAMERA_I2C_PORT);
+  if (i2c == NULL)
+    {
+      syslog(LOG_ERR, "Camera: failed to acquire I2C%d\n",
+             CAMERA_I2C_PORT);
+      return -ENODEV;
+    }
+
+  sensor = sc2336_initialize(i2c, CAMERA_WIDTH, CAMERA_HEIGHT);
+  if (sensor == NULL)
+    {
+      syslog(LOG_ERR, "Camera: failed to allocate SC2336 driver\n");
+      return -ENOMEM;
+    }
+
+  if (!IMGSENSOR_IS_AVAILABLE(sensor))
+    {
+      syslog(LOG_ERR, "Camera: SC2336 not detected on SCCB 0x30\n");
+      kmm_free(sensor);
+      return -ENODEV;
+    }
+
+  data = esp_mipi_csi_initialize();
+  if (data == NULL)
+    {
+      syslog(LOG_ERR, "Camera: failed to create MIPI-CSI data path\n");
+      kmm_free(sensor);
+      return -ENODEV;
+    }
+
+#ifdef CONFIG_ESPRESSIF_MIPI_CSI_BOOT_TEST
+  ret = camera_boot_test(sensor, data);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "Camera: boot capture test failed: %d\n", ret);
+      kmm_free(sensor);
+      return ret;
+    }
+#endif
+
+  imgdata_register(data);
+  ret = imgsensor_register(sensor);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "Camera: imgsensor_register failed: %d\n", ret);
+      kmm_free(sensor);
+      return ret;
+    }
+
+  ret = capture_initialize("/dev/video0");
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "Camera: /dev/video0 registration failed: %d\n",
+             ret);
+      return ret;
+    }
+
+  syslog(LOG_INFO,
+         "Camera: SC2336 1024x600 BGGR8 registered at /dev/video0\n");
+  return OK;
+}
diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
index daced586c79f2bc7c73b0e82d74f2ef364c5c5da..787977124073809673d77581ca0cb5f2a4944022 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -498,6 +498,13 @@ config VIDEO_GC0308
 	---help---
 		GC0308 VGA CMOS image sensor with DVP interface.
 
