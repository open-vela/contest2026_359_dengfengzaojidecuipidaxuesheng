#
# ESP32-P4 Function EV Board v1.0 autonomous LVGL touch desktop
#
# v1.0 uses the pre-v3 memory/linker layout and keeps UART0 available for
# diagnostics while desktop_main owns the LCD UI.
#
# CONFIG_ESPRESSIF_SPIRAM_MEMTEST is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_NSH_ARGCAT is not set
# CONFIG_NSH_CMDOPT_HEXDUMP is not set
CONFIG_ARCH="risc-v"
CONFIG_ARCH_BOARD="esp32p4-function-ev-board"
CONFIG_ARCH_BOARD_COMMON=y
CONFIG_ARCH_BOARD_ESP32P4_FUNCTION_EV_BOARD=y
CONFIG_ARCH_CHIP="esp32p4"
CONFIG_ARCH_CHIP_ESP32P4=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_IRQ_TO_NDX=y
CONFIG_ARCH_MINIMAL_VECTORTABLE_DYNAMIC=y
CONFIG_ARCH_NUSER_INTERRUPTS=17
CONFIG_ARCH_RISCV=y
CONFIG_BOARDCTL_RESET=y
CONFIG_BOARD_LOOPSPERMSEC=15000
CONFIG_BUILTIN=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_MM=y
CONFIG_ESP32P4_FUNCTION_EV_BOARD_LCD=y
CONFIG_ESP32P4_FUNCTION_EV_BOARD_TOUCHSCREEN=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPRESSIF_CPU_FREQ_180=y
CONFIG_ESPRESSIF_EMAC=y
CONFIG_ESPRESSIF_ETH_DMA_BUFFER_SIZE=512
CONFIG_ESPRESSIF_ETH_NRXDESC=8
CONFIG_ESPRESSIF_ETH_NTXDESC=8
CONFIG_ESPRESSIF_FLASH_16M=y
CONFIG_ESPRESSIF_I2C0_SCLPIN=8
CONFIG_ESPRESSIF_I2C0_SDAPIN=7
CONFIG_ESPRESSIF_MIPI_CSI=y
CONFIG_ESPRESSIF_SPIRAM=y
CONFIG_ESPRESSIF_SPIRAM_SPEED_80M=y
CONFIG_EXPERIMENTAL=y
CONFIG_FS_PROCFS=y
CONFIG_FS_TMPFS=y
CONFIG_GRAPHICS_LVGL=y
CONFIG_HA_PANEL=y
CONFIG_IDLETHREAD_STACKSIZE=2048
CONFIG_INIT_ENTRYNAME="ha_panel_main"
CONFIG_INIT_ENTRYPOINT="desktop_main"
CONFIG_INIT_STACKSIZE=32768
CONFIG_INPUT_GT9XX_X_INVERT_MAX=1024
CONFIG_INPUT_GT9XX_Y_INVERT_MAX=600
CONFIG_INTELHEX_BINARY=y
CONFIG_INTERPRETERS_QUICKJS=y
CONFIG_LIBC_MEMFD_ERROR=y
CONFIG_LIBC_PERROR_STDOUT=y
CONFIG_LIBC_STRERROR=y
CONFIG_LIBM=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_NUTTX=y
CONFIG_LV_USE_NUTTX_TOUCHSCREEN=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_MM_BACKTRACE=0
CONFIG_MM_DUMP_ON_FAILURE=y
CONFIG_MM_KERNEL_HEAP=y
CONFIG_MM_KERNEL_HEAPSIZE=131072
CONFIG_MM_REGIONS=3
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_NETINIT_DHCPC=y
CONFIG_NETINIT_DNS=y
CONFIG_NETINIT_THREAD=y
CONFIG_NETUTILS_DHCPC=y
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_READLINE=y
CONFIG_NSH_STRERROR=y
CONFIG_NXCAMERA_LOOPTHREAD_STACKSIZE=8192
